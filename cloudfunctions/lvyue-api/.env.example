# Tencent PostgreSQL (use a dedicated least-privilege account)
PGHOST=172.17.0.15
PGPORT=5432
PGDATABASE=postgres
PGUSER=lvyue_api
PGPASSWORD=replace-in-cloudbase-console
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=5

# Application authentication. Generate at least 32 random bytes; never commit the real value.
APP_JWT_SECRET=replace-with-a-long-random-secret
APP_JWT_TTL=7d
BCRYPT_COST=12

# CloudBase/COS storage
TCB_ENV_ID=lvyue-d6gyatb4a502c0235
TCB_STORAGE_REGION=ap-shanghai
# Must be the full COS bucket name, including the numeric APPID suffix.
# Find it by opening the bucket details page; the console list may only show the logical name.
COS_BUCKET=lvyue-media-1234567890

# In CloudBase functions, temporary Tencent credentials are injected automatically.
# Only use these names for local development; never commit their values.
TENCENTCLOUD_SECRETID=
TENCENTCLOUD_SECRETKEY=
TENCENTCLOUD_SESSIONTOKEN=

# Comma-separated exact production/preview origins. Do not use * in production.
CORS_ORIGINS=https://your-domain.example,https://your-project.vercel.app
